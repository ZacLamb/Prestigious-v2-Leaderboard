# ══════════════════════════════════════════════════════════════════════════
#  Railway Variables — the first three are required.
#  Both spreadsheets are hardcoded in src/config.js.
# ══════════════════════════════════════════════════════════════════════════

# Unlocks commission columns. Without it, viewers see funded volume, deal
# counts, fees and consolidation funded — but no commission figures.
ADMIN_PASSWORD=

# Signs the login session. Generate with:  openssl rand -base64 32
JWT_SECRET=

# Lets the Apps Script in each spreadsheet deliver its rows. This is how the
# app gets data when Google refuses anonymous reads — the script runs as the
# sheet's owner, so both sheets stay private.
#
# MUST NOT be the same as ADMIN_PASSWORD. This value gets pasted into a script
# inside a spreadsheet that the whole office can open; it must not be the
# credential that unlocks commission figures. The app refuses to start if the
# two match.
#
# Generate with:  openssl rand -hex 24
INGEST_SECRET=


# ── OPTIONAL: lead sources from the CRM ───────────────────────────────────
# Fills in a lead source ONLY where the sheet's Source cell is blank. The
# sheet always wins, and the CRM never supplies money, dates, brokers or
# lenders. Leave these unset and the dashboard stays sheets-only.
#
# Matching is by business name, so a deal with no CRM counterpart — or whose
# name resolves to two different sources — stays Unattributed rather than
# being guessed at.
#
# Tokens: Settings → Private Integrations → Create New
# Scopes needed: opportunities.readonly, locations.readonly
NY_LOCATION_ID=
NY_TOKEN=
MIAMI_LOCATION_ID=
MIAMI_TOKEN=

# Turn the backfill off without removing the tokens.
# CRM_SOURCE_LOOKUP=true


# ── OPTIONAL: everything else ─────────────────────────────────────────────

# How long pushed data stays trusted before the dashboard says so in a banner.
# Past this it also retries a direct sheet read, in case sharing is open.
# PUSH_STALE_MINUTES=90

# Where pushed snapshots are kept so a restart doesn't blank the board.
# Defaults to ./.data, falling back to the system temp directory.
# INGEST_DIR=

# Override only if a spreadsheet moves or a tab is rebuilt with a new gid.
# NY_SHEET_ID=
# NY_SHEET_GID=
# MIAMI_SHEET_ID=
# MIAMI_SHEET_GID=

# Timezone for MTD and month boundaries.
# REPORT_TZ=America/New_York

# Minutes to cache each sheet before re-reading.
# CACHE_TTL_MINUTES=10

# Revenue (commission + fees + consolidation commission) that fills a
# broker's progress bar to 100%.
# BAR_MAX=30000
